LEMP_PACKAGES="nginx mysql-server php-fpm php-mysql php-cli php-curl php-gd php-mbstring php-xml php-zip php-intl"
PHP_FPM_SERVICE="php8.5-fpm"
PHP_FPM_SOCKET="/run/php/php8.5-fpm.sock"
PHPMYADMIN_DIR="/usr/share/phpmyadmin"
NGINX_SITE_FILE="/etc/nginx/sites-available/default"
HTPASSWD_FILE="/etc/nginx/.htpasswd"
HTPASSWD_USER="admin"
MYSQL_DEDICATED_USER="admin"
